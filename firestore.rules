rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function activeMember() {
      return signedIn()
        && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.active == true;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.email == 'mr.dhalait@gmail.com'
        || (activeMember() && get(userPath(request.auth.uid)).data.role == 'admin')
      );
    }

    function isBoard() {
      return isAdmin()
        || (activeMember() && get(userPath(request.auth.uid)).data.role == 'executive');
    }

    match /allowedEmails/{email} {
      allow get: if isAdmin()
        || (signedIn() && request.auth.token.email == email);
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.email == email
        && request.resource.data.role in ['member', 'executive']
        && request.resource.data.keys().hasOnly(['email', 'role', 'addedAt', 'addedBy']);
      allow delete: if isAdmin();
    }

    match /users/{uid} {
      allow get, list: if activeMember() || (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.active == true
        && request.resource.data.keys().hasOnly(['email', 'displayName', 'role', 'active', 'createdAt'])
        && (
          (request.auth.token.email == 'mr.dhalait@gmail.com' && request.resource.data.role == 'admin')
          || (
            exists(/databases/$(database)/documents/allowedEmails/$(request.auth.token.email))
            && get(/databases/$(database)/documents/allowedEmails/$(request.auth.token.email)).data.role == request.resource.data.role
          )
        );
      allow update: if (
          isAdmin()
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName'])
        )
        || (
          signedIn()
          && request.auth.token.email == 'mr.dhalait@gmail.com'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 80
        );
      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    match /leaveRequests/{requestId} {
      allow get, list: if isBoard()
        || (activeMember() && resource.data.uid == request.auth.uid);
      allow create: if activeMember()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 10
        && request.resource.data.reason.size() <= 1000
        && request.resource.data.startDate is string
        && request.resource.data.startDate.size() == 10
        && request.resource.data.endDate is string
        && request.resource.data.endDate.size() == 10
        && request.resource.data.startDate <= request.resource.data.endDate
        && request.resource.data.days is int
        && request.resource.data.days > 0
        && request.resource.data.days <= 366
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'name', 'startDate', 'endDate', 'days', 'reason', 'status', 'createdAt'
        ]);
      allow update: if isBoard()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy'])
        && request.resource.data.status in ['approved', 'declined', 'pending']
        && request.resource.data.status != resource.data.status
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewedBy == request.auth.token.email;
      allow delete: if isAdmin();
    }
  }
}
